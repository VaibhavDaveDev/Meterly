---
import AuthLayout from '../layouts/AuthLayout.astro';
import { ForgotPasswordForm } from '../components/auth/ForgotPasswordForm';

// In dev mode, don't pass turnstile key so it skips validation
const turnstileKey = import.meta.env.PROD ? import.meta.env.PUBLIC_TURNSTILE_SITE_KEY : undefined;
---

<AuthLayout title="Reset Password" description="Reset your Meterly account password" type="forgot">
  <ForgotPasswordForm client:load turnstileSiteKey={turnstileKey} />
</AuthLayout>
